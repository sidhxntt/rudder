# Copy to .env and fill in. Never commit .env.

# --- Postgres (compose) ---
POSTGRES_USER=rudder
POSTGRES_PASSWORD=rudder
POSTGRES_DB=rudder

# Optional local-only Phase 3 physical PostgreSQL backups. Leave every value
# blank to keep backup controls hidden. These static S3 credentials are for a
# private Kind/MinIO development target only; GKE rejects them so production
# database pods never receive long-lived cloud credentials.
RUDDER_KUBERNETES_BACKUP_S3_ENDPOINT=
RUDDER_KUBERNETES_BACKUP_S3_BUCKET=
RUDDER_KUBERNETES_BACKUP_S3_ACCESS_KEY=
RUDDER_KUBERNETES_BACKUP_S3_SECRET_KEY=
RUDDER_KUBERNETES_BACKUP_S3_REGION=us-east-1
# Six-field CloudNativePG cron (seconds first). Used only with a configured
# backup destination; the default is a base backup daily at 02:00 UTC.
RUDDER_KUBERNETES_BACKUP_SCHEDULE="0 0 2 * * *"

# GKE only: native CloudNativePG GCS backups. No static cloud credential is
# allowed. Set IDENTITY_READY=true only after the separately authorised backup
# identity broker is live and verified; it creates and verifies the exact
# per-environment CNPG Kubernetes ServiceAccount ↔ Google Service Account
# binding during reconciliation.
RUDDER_KUBERNETES_BACKUP_GCS_BUCKET=
RUDDER_KUBERNETES_BACKUP_GCP_SERVICE_ACCOUNT=
RUDDER_KUBERNETES_BACKUP_GCS_IDENTITY_READY=false

# --- Control plane ---
# Host-side value. Compose overrides this to point at the `postgres` service.
RUDDER_DATABASE_URL=postgresql+psycopg://rudder:rudder@localhost:5432/rudder

# Fernet keys, comma-separated, first key encrypts (D13 — MultiFernet rotation).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RUDDER_SECRET_KEYS=

# JWT signing secret. Generate: openssl rand -hex 32
RUDDER_JWT_SECRET=

# Single seeded user (no signup — Phase 1 step 3).
RUDDER_ADMIN_EMAIL=you@example.com
RUDDER_ADMIN_PASSWORD=change-me

# --- Git ---
# PAT with `repo` (read) scope, for cloning private repos (D2).
# Leave blank if every repo you deploy is public.
GITHUB_TOKEN=
# Shared secret configured on the GitHub webhook; HMAC-verified on receipt.
RUDDER_GITHUB_WEBHOOK_SECRET=

# GitHub App credentials for the Vercel-style repository picker. The app must
# be installed on selected repositories and have Contents: Read permission.
RUDDER_GITHUB_APP_ID=
RUDDER_GITHUB_APP_SLUG=
# Preserve newlines as \n when storing this in an environment variable.
RUDDER_GITHUB_APP_PRIVATE_KEY=
# Preferred for local or mounted PEMs; avoids copying the key into `.env`.
RUDDER_GITHUB_APP_PRIVATE_KEY_FILE=

# GitHub OAuth App credentials used for user sign-in. Configure the callback
# URL in GitHub to match RUDDER_GITHUB_OAUTH_REDIRECT_URI.
RUDDER_GITHUB_OAUTH_CLIENT_ID=
RUDDER_GITHUB_OAUTH_CLIENT_SECRET=
RUDDER_GITHUB_OAUTH_REDIRECT_URI=

# --- Routing (D8) ---
# For GKE, this must exactly equal RUDDER_KUBERNETES_PUBLIC_DOMAIN so the
# system domains Rudder records are also the domains its ingress serves.
RUDDER_TLS_MODE=off
RUDDER_BASE_DOMAIN=localhost
RUDDER_ACME_EMAIL=

# --- Build + runtime ---
RUDDER_REGISTRY=localhost:5000
RUDDER_BUILDKIT_ADDR=tcp://registry:1234
# GKE only: Cloud Build receives a short-lived source archive authenticated by
# Workload Identity. Leave these blank for local Compose/Kind development.
RUDDER_GCP_PROJECT_ID=
RUDDER_GCP_REGION=
RUDDER_GCP_BUILD_SOURCE_BUCKET=
RUDDER_GCP_BUILD_LOGS_BUCKET=
RUDDER_GCP_BUILD_SERVICE_ACCOUNT=
RUDDER_DOCKER_NETWORK=rudder
RUDDER_AGENT_URL=http://agent:9000
# Shared by the control plane and every node agent. Generate: openssl rand -hex 32
RUDDER_AGENT_SHARED_SECRET=
RUDDER_TRAEFIK_DYNAMIC_DIR=/traefik/dynamic
RUDDER_BUILD_LOG_DIR=/var/log/rudder/builds

# --- Phase 3: local Kubernetes runtime ---
# Keep Docker as the default. `make kind-up` provisions the local cluster;
# then start the control plane with RUDDER_RUNTIME=kubernetes.
RUDDER_RUNTIME=docker
# `kind` uses the developer kubeconfig. `gke` is production-only and requires
# the control plane to run in GKE with a non-local public application domain.
RUDDER_KUBERNETES_TARGET=kind
# The web import flow enables this automatically in development. Set to false
# only when a developer deliberately wants to manage Kind by hand.
RUDDER_LOCAL_KUBERNETES_AUTO_BOOTSTRAP=true
RUDDER_KUBERNETES_KUBECONFIG=
RUDDER_KUBERNETES_NAMESPACE_PREFIX=rudder
RUDDER_KUBERNETES_INGRESS_CLASS=nginx
# GKE currently shares its tainted platform pool with customer workloads while
# CPUS_ALL_REGIONS is 12. Kind ignores this setting. Do not change it until a
# reviewed Terraform migration creates a dedicated workloads pool.
RUDDER_KUBERNETES_WORKLOAD_POOL=platform
# Required for RUDDER_KUBERNETES_TARGET=gke. The Phase 4 bootstrap creates
# this ClusterIssuer with Cloud DNS and GKE Workload Identity; do not put a
# Cloud DNS JSON key in this file.
RUDDER_KUBERNETES_CERTIFICATE_ISSUER=
# Required by the GKE platform bootstrap. This must be the delegated Cloud DNS
# zone (without the trailing dot), for example rudder.example.com.
RUDDER_DNS_NAME=
# Required by the GKE platform bootstrap. This is the Google Cloud DNS managed
# zone resource name (for example rudder-subdomain), not the DNS suffix.
RUDDER_GCP_DNS_ZONE=
# Pin the chart used by the production platform bootstrap; never use a moving
# `latest` tag for a controller that can create or remove DNS records.
EXTERNAL_DNS_CHART_VERSION=
# Public hosts generated by the local Kind ingress. This can differ from
# RUDDER_BASE_DOMAIN when the control-plane UI has its own domain.
RUDDER_KUBERNETES_LOCAL_DOMAIN=localhost
# Required when RUDDER_KUBERNETES_TARGET=gke. Do not use a .localhost name.
RUDDER_KUBERNETES_PUBLIC_DOMAIN=
RUDDER_KUBERNETES_READINESS_TIMEOUT_SECONDS=180

# --- Phase 6 only. Nothing else in the system touches an LLM. ---
ANTHROPIC_API_KEY=
