# Copy to production.tfvars locally. Do not commit credentials, Terraform
# backend values, or any secret material. GKE operator access uses the DNS
# endpoint and Google IAM rather than a fixed public IP allow-list.
project_id   = "invytt-2483d"
region       = "asia-south1"
cluster_name = "rudder-gke"

# Set true only after the project-wide CPUS_ALL_REGIONS quota is approved for
# at least 18 vCPUs. The current system and platform pools already use 12.
enable_workloads_pool = false
