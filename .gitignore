.env
.env.local.development
.env.local.production
!.env.local.development.example
!.env.local.production.example
*.pyc
__pycache__/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

node_modules/
.next/
out/

# Generated Traefik routers — control plane owns this directory at runtime.
infra/traefik/dynamic/*.yml
# Generated by `make kind-up`; grants the local Docker control plane access to
# the disposable Kind cluster and must never be committed.
infra/kind/kubeconfig

# Cloud and app credentials: GCP service account JSON, GitHub App private keys.
# Never commit these. Phase 4 moves runtime credentials to Workload Identity so
# no long-lived key file is needed in the first place — see ADR 0004 and
# docs/phases/PHASE-4-mesh.md step 2.
keys/
*.pem
*-service-account*.json

.DS_Store
.agents/
.claude/

# Local test/runtime state; schemas and migrations belong in source control,
# SQLite database files do not.
*.db
.codex/
.worktrees/
.superpowers/
