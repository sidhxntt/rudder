# Production environment inventory — copy to .env.local.production only for operator reference.
# Production runtime secrets belong in Secret Manager/Kubernetes Secrets, never in this file.

RUDDER_RUNTIME=kubernetes
RUDDER_KUBERNETES_TARGET=gke
RUDDER_KUBERNETES_WORKLOAD_POOL=platform
RUDDER_KUBERNETES_PUBLIC_DOMAIN=<public-domain>
RUDDER_BASE_DOMAIN=<same-public-domain>
RUDDER_TLS_MODE=acme
RUDDER_ACME_EMAIL=<operations-email>
RUDDER_KUBERNETES_CERTIFICATE_ISSUER=<clusterissuer>
RUDDER_REGISTRY=<region>-docker.pkg.dev/<project>/<repository>
RUDDER_GCP_PROJECT_ID=<project-id>
RUDDER_GCP_REGION=<region>
RUDDER_GCP_BUILD_SOURCE_BUCKET=<private-source-bucket>
RUDDER_GCP_BUILD_LOGS_BUCKET=<private-build-log-bucket>
RUDDER_GCP_BUILD_SERVICE_ACCOUNT=<cloud-build-publisher-gsa>
RUDDER_KUBERNETES_API_SERVER_ENDPOINT_CIDR=<private-gke-api-cidr>/32
RUDDER_KUBERNETES_POSTGRES_OPERATOR=cloudnativepg

# These are Secret Manager/Kubernetes Secret entries, not plaintext dotenv values:
# RUDDER_SECRET_KEYS
# RUDDER_JWT_SECRET
# RUDDER_ADMIN_EMAIL
# RUDDER_ADMIN_PASSWORD
# RUDDER_AGENT_SHARED_SECRET
# GITHUB_TOKEN
# RUDDER_GITHUB_WEBHOOK_SECRET
# RUDDER_GITHUB_OAUTH_CLIENT_ID
# RUDDER_GITHUB_OAUTH_CLIENT_SECRET
# RUDDER_GITHUB_APP_ID
# RUDDER_GITHUB_APP_PRIVATE_KEY
# ANTHROPIC_API_KEY

# Set only after the private identity broker has been verified.
RUDDER_KUBERNETES_BACKUP_GCS_BUCKET=
RUDDER_KUBERNETES_BACKUP_GCP_SERVICE_ACCOUNT=
RUDDER_KUBERNETES_BACKUP_IDENTITY_BROKER_URL=
RUDDER_KUBERNETES_BACKUP_GCS_IDENTITY_READY=false
