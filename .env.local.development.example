# Development environment inventory — copy to .env.local.development and fill locally.
# This file is intentionally safe to commit; the actual .env.local.development is ignored.

POSTGRES_USER=rudder
POSTGRES_PASSWORD=<local-postgres-password>
POSTGRES_DB=rudder

RUDDER_SECRET_KEYS=<generated-fernet-key>
RUDDER_JWT_SECRET=<generated-jwt-secret>
RUDDER_ADMIN_EMAIL=<local-admin-email>
RUDDER_ADMIN_PASSWORD=<local-admin-password>
RUDDER_AGENT_SHARED_SECRET=<generated-agent-secret>

RUDDER_RUNTIME=docker
RUDDER_KUBERNETES_TARGET=kind
# Kind's in-cluster Kubernetes API Service. Required when Rudder creates a
# default-deny NetworkPolicy so CloudNativePG can initialize managed Postgres.
RUDDER_KUBERNETES_API_SERVER_ENDPOINT_CIDR=10.96.0.1/32
RUDDER_TLS_MODE=off
RUDDER_BASE_DOMAIN=localhost
# Keep this port free, use the same port in both values, and configure it as
# an insecure registry in Docker Desktop.  Use 5001 when another app owns 5000.
RUDDER_REGISTRY=localhost:5000
RUDDER_REGISTRY_PORT=5000
RUDDER_DOCKER_NETWORK=rudder

# Optional: leave blank until configured.
GITHUB_TOKEN=
RUDDER_GITHUB_WEBHOOK_SECRET=
RUDDER_GITHUB_OAUTH_CLIENT_ID=
RUDDER_GITHUB_OAUTH_CLIENT_SECRET=
RUDDER_GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback
RUDDER_GITHUB_APP_ID=
RUDDER_GITHUB_APP_SLUG=
RUDDER_GITHUB_APP_PRIVATE_KEY_FILE=
ANTHROPIC_API_KEY=
