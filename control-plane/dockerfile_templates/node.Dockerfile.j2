# syntax=docker/dockerfile:1
# Generated by Rudder — do not commit this to the application repo.
# Two stages: `builder` holds the toolchain and devDependencies and is discarded;
# `runtime` receives only the pruned app tree, which is what gets pushed.

ARG NODE_VERSION={{ node_version }}

FROM node:${NODE_VERSION}-alpine AS builder
WORKDIR /app

# Manifests before source: this layer stays cached until a dependency actually
# changes, so a source-only push skips the install entirely.
# The trailing `*` makes each lockfile optional — a glob matching nothing is
# ignored as long as at least one source (package.json) matches.
COPY package.json package-lock.json* yarn.lock* pnpm-lock.yaml* ./

{% if package_manager == 'pnpm' %}
# corepack ships inside the node image and honours package.json "packageManager".
RUN corepack enable && pnpm install --frozen-lockfile
{% elif package_manager == 'yarn' %}
RUN yarn install --frozen-lockfile
{% elif lockfile %}
# `npm ci` is reproducible but requires the lockfile; without one it errors out.
RUN npm ci
{% else %}
RUN npm install
{% endif %}

COPY . .
{% if has_build_script %}
RUN {{ package_manager }} run build
{% endif %}

# Drop devDependencies before the tree is copied into the runtime stage. Done
# here, not in runtime, so the removed files never land in a shipped layer.
{% if package_manager == 'pnpm' %}
RUN pnpm prune --prod
{% elif package_manager == 'yarn' %}
RUN yarn install --production --frozen-lockfile --ignore-scripts
{% else %}
RUN npm prune --omit=dev
{% endif %}

FROM node:${NODE_VERSION}-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

# Rudder passes Service.container_port in as a build arg; the app reads it back
# as $PORT at runtime. Nothing is published to the host — Traefik reaches the
# container over the shared Docker network.
ARG PORT={{ port }}
ENV PORT=${PORT}

# The official node image already carries an unprivileged `node` user (uid 1000).
COPY --from=builder --chown=node:node /app /app
USER node
EXPOSE ${PORT}

{% if start_command %}
# Service.start_command wins over anything the repo declares. `exec` hands PID 1
# to the app so SIGTERM reaches it directly when Rudder drains the instance.
CMD ["sh", "-c", {{ ("exec " ~ start_command) | jsonstr }}]
{% elif start_script %}
# The repo declares scripts.start: {{ start_script }}
CMD ["{{ package_manager }}", "run", "start"]
{% else %}
# No start script — node resolves `.` through package.json "main" (index.js).
CMD ["node", "."]
{% endif %}
