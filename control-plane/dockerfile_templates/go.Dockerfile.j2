# syntax=docker/dockerfile:1
# Generated by Rudder — do not commit this to the application repo.
# Two stages: `builder` carries the Go toolchain (~800MB) and is discarded;
# `runtime` is alpine plus one static binary.

ARG GO_VERSION={{ go_version }}

FROM golang:${GO_VERSION}-alpine AS builder
WORKDIR /src

# Module files before source so `go mod download` is cached independently of
# application code. go.sum is optional — a module with no external deps has none.
COPY go.mod go.sum* ./
RUN go mod download

COPY . .
# CGO_ENABLED=0 produces a static binary, which is why the runtime stage needs no
# libc. -trimpath strips build-machine paths; -s -w drop the symbol table and
# DWARF info, usually a third of the binary size.
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/{{ binary_name }} .

FROM alpine:3.20 AS runtime
# ca-certificates is the one thing a static Go binary still needs from the base
# image — without it every outbound HTTPS call fails x509 verification.
RUN apk add --no-cache ca-certificates \
    && adduser -D -u 10001 app
COPY --from=builder /out/{{ binary_name }} /usr/local/bin/{{ binary_name }}

# Rudder passes Service.container_port in as a build arg; the app reads it back
# as $PORT at runtime. Nothing is published to the host — Traefik reaches the
# container over the shared Docker network.
ARG PORT={{ port }}
ENV PORT=${PORT}

USER app
EXPOSE ${PORT}

{% if start_command %}
# Service.start_command wins over the compiled default. `exec` hands PID 1 to the
# app so SIGTERM reaches it directly when Rudder drains the instance.
CMD ["sh", "-c", {{ ("exec " ~ start_command) | jsonstr }}]
{% else %}
# Module {{ binary_name }}, built from the root package.
CMD ["/usr/local/bin/{{ binary_name }}"]
{% endif %}
