# syntax=docker/dockerfile:1
# Generated by Rudder — do not commit this to the application repo.
# Two stages: `builder` resolves dependencies into a self-contained virtualenv;
# `runtime` copies that venv and the source, and carries no build tooling.

ARG PYTHON_VERSION={{ python_version }}

FROM python:${PYTHON_VERSION}-slim AS builder
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /app

# A venv rather than --user or system site-packages: it makes the entire
# dependency tree one relocatable directory the runtime stage can take in a
# single COPY.
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

{% if toolchain == 'poetry' %}
RUN pip install --no-cache-dir poetry poetry-plugin-export
COPY pyproject.toml poetry.lock* ./
# Export to requirements instead of `poetry install` so poetry itself never
# reaches the runtime venv.
RUN poetry export --without-hashes --format requirements.txt --output /tmp/requirements.txt \
    && pip install --no-cache-dir --requirement /tmp/requirements.txt
{% elif toolchain == 'uv' %}
RUN pip install --no-cache-dir uv
COPY pyproject.toml uv.lock* ./
# --frozen makes a stale lockfile fail the build instead of silently resolving
# something the developer never tested.
RUN uv export --frozen --no-dev --no-emit-project --output-file /tmp/requirements.txt \
    && uv pip install --no-cache --requirement /tmp/requirements.txt
{% else %}
COPY requirements.txt* pyproject.toml* ./
# Detection accepts either marker, so the install has to handle either one.
RUN if [ -f requirements.txt ]; then pip install --no-cache-dir --requirement requirements.txt; \
    else pip install --no-cache-dir .; fi
{% endif %}

FROM python:${PYTHON_VERSION}-slim AS runtime
WORKDIR /app
ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Rudder passes Service.container_port in as a build arg; the app reads it back
# as $PORT at runtime. Nothing is published to the host — Traefik reaches the
# container over the shared Docker network.
ARG PORT={{ port }}
ENV PORT=${PORT}

COPY --from=builder /opt/venv /opt/venv
COPY . .

# slim has no unprivileged account. The uid is fixed so a bind-mounted volume
# keeps a stable owner across rebuilds.
RUN useradd --system --uid 10001 --create-home --home-dir /home/app app \
    && chown -R app:app /app
USER app
EXPOSE ${PORT}

{% if start_command %}
# Service.start_command wins over anything inferred from the repo. `exec` hands
# PID 1 to the app so SIGTERM reaches it directly when Rudder drains the instance.
CMD ["sh", "-c", {{ ("exec " ~ start_command) | jsonstr }}]
{% elif asgi_target %}
# An ASGI application object was found at {{ asgi_target }}. sh -c because $PORT
# has to be expanded at container start, not baked in at build time.
CMD ["sh", "-c", {{ ("exec uvicorn " ~ asgi_target ~ " --host 0.0.0.0 --port ${PORT}") | jsonstr }}]
{% else %}
# No ASGI app object found — run the script that looks like the entrypoint.
CMD ["python", "{{ entrypoint }}"]
{% endif %}
