# syntax=docker/dockerfile:1
# Generated by Rudder. The builder is discarded; nginx receives only the
# static output and runs unprivileged on the service's assigned port.
ARG NODE_VERSION={{ node_version }}
FROM node:${NODE_VERSION}-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json* yarn.lock* pnpm-lock.yaml* ./
{% if package_manager == 'pnpm' %}
RUN corepack enable && pnpm install --frozen-lockfile
{% elif package_manager == 'yarn' %}
RUN yarn install --frozen-lockfile
{% elif lockfile %}
RUN npm ci
{% else %}
RUN npm install
{% endif %}
{% for key in build_env_keys %}
ARG {{ key }}
{% endfor %}
COPY . .
RUN {{ package_manager }} run build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
ARG PORT={{ port }}
COPY --from=builder /app/{{ output_dir }}/ /usr/share/nginx/html/
RUN printf '%s\\n' \
  'server {' \
  '  listen '"${PORT}"';' \
  '  server_name _;' \
  '  root /usr/share/nginx/html;' \
  '  index index.html;' \
  '  location = /index.html { add_header Cache-Control "no-cache" always; }' \
  '  location ~* \\.[0-9a-z]{8,}\\.(js|css|mjs|map|woff2?|png|jpg|jpeg|gif|svg|ico)$ { expires 1y; add_header Cache-Control "public, immutable" always; try_files $uri =404; }' \
{% if spa_fallback %}
  '  location / { try_files $uri $uri/ /index.html; }' \
{% else %}
  '  location / { try_files $uri $uri/ =404; }' \
{% endif %}
  '}' > /etc/nginx/conf.d/default.conf
EXPOSE ${PORT}
